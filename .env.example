# Docker Compose listener ports. The PWA listens on PWA_LISTEN_PORT in the container.
PWA_HOST_PORT=50001
PWA_LISTEN_PORT=50001

# Use / for root deployment, or a trailing-slash path such as /incomudon/.
INCOMUDON_BASE_PATH=/

# Multi-channel console. Defaults to <base path>/multi. The browser may add up to 10 slots.
INCOMUDON_MULTI_MAX_SLOTS=10
# Initial slot count for a browser without an existing local setting; capped by the maximum.
INCOMUDON_MULTI_DEFAULT_SLOTS=4
# Leave empty for the default URL, or set an absolute/custom path such as /incomudon/console.
INCOMUDON_MULTI_PATH=

# Recommended for public deployment. Example: relay.example.com:50000
# INCOMUDON_FIXED_RELAY=

# Authentication: none, basic, or oidc.
INCOMUDON_AUTH_MODE=none

# Optional additional WebSocket shared token.
# INCOMUDON_WS_TOKEN=

# Basic authentication settings when INCOMUDON_AUTH_MODE=basic.
# INCOMUDON_BASIC_USER=
# INCOMUDON_BASIC_PASS=

# OIDC settings when INCOMUDON_AUTH_MODE=oidc.
# INCOMUDON_OIDC_ISSUER=https://accounts.example.com/realms/incomudon
# INCOMUDON_OIDC_CLIENT_ID=incomudon-pwa
# INCOMUDON_OIDC_CLIENT_SECRET=
# INCOMUDON_OIDC_SESSION_SECRET=
# INCOMUDON_OIDC_SCOPES=openid,profile,email
# INCOMUDON_OIDC_REDIRECT_URL=https://pwa.example.com/auth/callback
INCOMUDON_OIDC_SESSION_TTL=72h

# Optional explicit dynamic library paths inside the container.
# INCOMUDON_CODEC2_LIB=/opt/libcodec2/linux-x86_64/libcodec2.so
# INCOMUDON_OPUS_LIB=/opt/libopus/linux-x86_64/libopus.so

# Optional PSK-protected directory provisioning from the Relay Server.
# Keep directory.psk private. The UDP host port must be reachable only from the relay.
PWA_DIRECTORY_UDP_HOST_PORT=51000
PWA_DIRECTORY_UDP_LISTEN_PORT=51000
INCOMUDON_DIRECTORY_DATA_DIR=./directory
# INCOMUDON_DIRECTORY_UDP_LISTEN=:51000
# INCOMUDON_DIRECTORY_PSK_FILE=/run/incomudon-directory/directory.psk
INCOMUDON_DIRECTORY_KEY_ID=pwa-1
# INCOMUDON_DIRECTORY_UDP_ALLOW_CIDRS=203.0.113.10/32
# Optional Relay directory pull listener. Enables authenticated manual refreshes.
# INCOMUDON_DIRECTORY_RELAY_UDP_TARGET=relay.example.com:51001
